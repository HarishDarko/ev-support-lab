# Cloudflare Pages response headers for the static files (the Pages Functions under /api set their own).
# The script hash is the inline theme script in index.html; tests/headers.test.ts fails if the two drift apart.
# Inline styles stay allowed because React and Motion set element styles. Fonts may be data: URIs in the CSS.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-gu9VMiqPvF+UoY4j7WQqZ52hDCJFGkwgJgophGuKznE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Vite puts a content hash in every file name under /assets, so a file there never changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
